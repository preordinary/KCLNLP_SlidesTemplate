# Office temporary / lock files
~$*
*.tmp

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Python (in case of helper scripts)
__pycache__/
*.py[cod]
.venv/
venv/


# .claude settings
.claude/

# Superpowers brainstorming session files
.superpowers/

# Superpowers design specs and implementation plans (maintainer-local)
docs/superpowers/

# Template source code — lab members only need the .pptx files.
# Code stays out of the repo; maintainers keep local copies.
templates/*/build.py
templates/*/poster.py
templates/*/theme.py
templates/*/textures.py
requirements.txt
templates/*/*.pdf

# Maintainer-only helper scripts (HTML preview rendering, etc.) —
# same policy as the pptx build scripts: code stays local.
scripts/

# Working scratch dir for re-extracted template media
templates/original_standard/.media_extracted/
